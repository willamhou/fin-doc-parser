# ============================================================
# fin-doc-parser Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.

# --- LLM Provider API Keys ---
# At least one is required. DeepSeek recommended for Chinese documents.

# DeepSeek API key (recommended: cheap + strong Chinese ability)
DEEPSEEK_API_KEY=sk-...

# OpenAI API key (alternative)
OPENAI_API_KEY=sk-...

# --- OCR Service ---
# Only required when using ocr_backend="prismer"

# Prismer OCR service base URL (e.g., http://localhost:8000)
PRISMER_OCR_BASE_URL=
